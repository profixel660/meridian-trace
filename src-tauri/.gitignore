# Cargo build artefacts
target/

# Downloaded by tauri-bundler at build time on Windows for MSI packaging.
WixTools/

# Tauri-generated schemas / capability artefacts (regenerated by `tauri build`).
gen/

# NOTE: Cargo.lock IS tracked — Tauri docs recommend committing it for binary
# applications so the exact dependency tree used to produce the .msi is
# reproducible. Do NOT add it to this file.
